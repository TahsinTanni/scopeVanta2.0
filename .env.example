# App's public URL, no trailing slash (e.g. https://app.example.com). Used for
# the Square webhook signature and links back into the app.
NEXT_PUBLIC_APP_URL=""

# Postgres (Supabase). Three URLs, because Supabase's poolers behave differently:
# - DATABASE_URL: the app's runtime connection — the TRANSACTION pooler (port 6543).
# - MIGRATE_DATABASE_URL: Prisma CLI / migrations — the SESSION pooler (port 5432).
#   Migrations hang on the transaction pooler (see prisma.config.ts).
# - DIRECT_DATABASE_URL: direct connection; fallback for migrations and scripts.
DATABASE_URL="postgresql://user:password@localhost:5432/scopevanta?schema=public"
MIGRATE_DATABASE_URL=""
DIRECT_DATABASE_URL=""

# Clerk (https://dashboard.clerk.com) — development keys are pk_test_/sk_test_,
# production keys pk_live_/sk_live_ (a separate instance with its own users).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# Where Clerk lands a user after sign-in/up; /dashboard routes on to workspace setup and onboarding.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# Square (billing). Sandbox and production have different values for all of these.
# "sandbox" or "production" — which Square API host and card-form script to use; unset = production.
SQUARE_ENVIRONMENT="sandbox"
SQUARE_ACCESS_TOKEN=""
# Public Application ID (Developer Console → Credentials) for the in-app card form.
SQUARE_APPLICATION_ID=""
# From the webhook subscription (events: subscription.created, subscription.updated,
# invoice.payment_made, invoice.scheduled_charge_failed).
SQUARE_WEBHOOK_SIGNATURE_KEY=""
# Must match the webhook URL registered in Square exactly; defaults to
# NEXT_PUBLIC_APP_URL + /api/square/webhook.
SQUARE_WEBHOOK_NOTIFICATION_URL=""

# Vercel Blob — two stores, because Vercel sets public/private per store:
# - BLOB_READ_WRITE_TOKEN: a PUBLIC store, for logos (shown on client share pages).
# - BLOB_PRIVATE_READ_WRITE_TOKEN: a PRIVATE store, for knowledge documents.
#   Document uploads are refused if this is missing (never stored publicly).
BLOB_READ_WRITE_TOKEN=""
BLOB_PRIVATE_READ_WRITE_TOKEN=""

# Anthropic (https://console.anthropic.com) — required by src/lib/ai.ts for
# every AI route (analyze, refine, commercial-lab, deal-os, proposal-studio,
# win-plan, close-coach, support, knowledge extraction). Also set a monthly
# spend limit in the Anthropic console.
ANTHROPIC_API_KEY=""
# Optional model override; defaults to the model in src/lib/ai.ts.
ANTHROPIC_MODEL=""
# Optional AI abuse/cost ceilings (defaults: 300 calls per workspace per 24h,
# 30 support messages per user per hour).
AI_DAILY_CALL_LIMIT=""
AI_SUPPORT_HOURLY_LIMIT=""

# Dev-only entitlement bypass (see lib/square.ts hasDevEntitlementBypass).
# Never set true in production; inert whenever NODE_ENV === "production".
SCOPEVANTA_DEV_UNLIMITED_ENTITLEMENT="false"

# Dev-only: lets platform staff open /admin without two-factor auth and skips
# the re-enter-password prompt on sensitive admin actions. Inert whenever
# NODE_ENV === "production" (see lib/admin/auth.ts).
ADMIN_ALLOW_NO_MFA="false"

# Human-contact fallback shown in the support chat widget (SupportChat.tsx)
# when the AI concierge isn't enough. Leave unset to show a generic
# "contact support via your account email" line instead of a mailto link.
NEXT_PUBLIC_SUPPORT_EMAIL=
